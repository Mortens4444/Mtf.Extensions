<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>Mtf.Windows.Forms.Extensions</id>
    <version>1.0.1</version>
    <description>
      The library includes various Extensions, such as:
      - ComboBoxExtensions
      - ControlCollectionExtensions
      - ControlExtensions
      - ListViewExtensions
      - ListViewItemCollectionExtensions
      - ListViewItemExtensions
      - PictureBoxExtensions
      - StringExtensions
      - TableLayoutPanelExtensions
      - ToolStripMenuItemExtensions
      
      Compatibility:
      - .NET Framework 4.6.2
      - .NET Framework 4.8.1
      - .NET 8
      - .NET 9
	</description>
    <authors>Mortens</authors>
	<owners>Mortens</owners>
    <copyright>Copyright © 2024</copyright>
	<license type="expression">MIT</license>
	<projectUrl>https://github.com/Mortens4444/Mtf.Extensions</projectUrl>
    <repository type="git" url="https://github.com/Mortens4444/Mtf.Extensions.git" branch="main" />
	<tags>ComboBoxExtensions ControlCollectionExtensions ControlExtensions ListViewExtensions ListViewItemCollectionExtensions ListViewItemExtensions PictureBoxExtensions StringExtensions TableLayoutPanelExtensions ToolStripMenuItemExtensions Mortens</tags>
	<readme>docs\ReadMe - Mtf.Windows.Forms.Extensions.md</readme>
    <dependencies>
	  <group targetFramework="net462">
	  </group>
	  <group targetFramework="net481">
	  </group>
	  <group targetFramework="net8.0-windows7">
        <dependency id="System.Drawing.Common" version="9.0.5" />
	  </group>
	  <group targetFramework="net9.0-windows7">
        <dependency id="System.Drawing.Common" version="9.0.5" />
	  </group>
    </dependencies>
  </metadata>
  <files>
    <file src=".\Mtf.Windows.Forms.Extensions\bin\Release\net462\**" target="lib\net462" />
    <file src=".\Mtf.Windows.Forms.Extensions\bin\Release\net481\**" target="lib\net481" />
    <file src=".\Mtf.Windows.Forms.Extensions\bin\Release\net8.0-windows\**" target="lib\net8.0-windows7" />
