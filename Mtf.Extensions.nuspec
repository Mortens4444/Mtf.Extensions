<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>Mtf.Extensions</id>
    <version>1.0.0</version>
    <description>
      The library includes various extension classes, such as:
      - BrushExtensions
      - ByteArrayExtensions
      - ByteExtensions
      - CharExtensions
      - ColorExtensions
      - DateTimeExtensions
      - DictionaryExtension
      - DoubleExtensions
      - EndPointExtensions
      - EnumExtensions
      - ExceptionExtensions
      - GenericExtensions
      - Int64Extensions
      - IntExtensions
      - MathExtensions
      - ObjectArrayExtensions
      - ObjectExtensions
      - RectangleExtensions
      - SocketExtensions
      - StringExtensions
      - TaskExtensions
      - TypeExtensions
      - UInt16Extensions
      - XmlDocumentExtensions
      - ZipFileExtensions
      
      Compatibility:
      - .NET Standard 2.0
    </description>
    <authors>Mortens</authors>
    <owners>Mortens</owners>
    <copyright>Copyright © 2025</copyright>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/Mortens4444/Mtf.Extensions</projectUrl>
    <repository type="git" url="https://github.com/Mortens4444/Mtf.Extensions.git" branch="main" />
    <tags>BrushExtensions ByteArrayExtensions ByteExtensions CharExtensions ColorExtensions DateTimeExtensions DictionaryExtension  DoubleExtensions EndPointExtensions EnumExtensions ExceptionExtensions GenericExtensions Int64Extensions IntExtensions MathExtensions ObjectArrayExtensions ObjectExtensions RectangleExtensions SocketExtensions StringExtensions TaskExtensions TypeExtensions UInt16Extensions XmlDocumentExtensions ZipFileExtensions Mortens</tags>
    <readme>docs\ReadMe.md</readme>
    <dependencies>
      <group targetFramework="netstandard2.0">
        <dependency id="System.Drawing.Common" version="9.0.5" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src=".\Mtf.Extensions\bin\Release\netstandard2.0\**" target="lib\netstandard2.0" />
    <file src=".\ReadMe.md" target="docs\" />
  </files>
</package>
